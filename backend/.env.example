# Copy this file to .env (gitignored) and fill in real values. Both
# docker-compose.yml and pwm.WebAPI read the same file - see Program.cs's
# LoadDotEnvFile for how the API picks it up.

# The SQL Server `sa` password: docker-compose sets it on first init, and
# BuildConnectionString in Program.cs appends it to PWMConnection.
DB_PASSWORD=

# Signs and verifies every JWT the API issues. appsettings.json's JwtToken
# section carries the issuer, audience and lifetimes - never this.
JWT_SECRET=

# RabbitMq:* config (bound by both pwm.WebAPI and pwm.Worker) - none of this
# lives in appsettings.json. Host/port are only what `dotnet run` uses (the
# broker's port published to the host); the api/worker containers instead get
# HostName=rabbitmq/Port=5672 directly from docker-compose.yml, since that is
# compose-network topology rather than a secret. UserName/Password/
# ReportQueueName are the same either way, so both read them from here.
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__ReportQueueName=report-generation
