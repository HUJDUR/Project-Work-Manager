# Copy this file to .env (gitignored) and fill in real values. It is the one
# place every setting lives: docker-compose.yml loads it into the api and
# worker containers (env_file), and a host-run pwm.WebAPI/pwm.Worker reads it
# through EnvironmentConfig.LoadDotEnvFile. Nothing here is in appsettings.json.

# Database. DB_SERVER is the host-side address (the port docker-compose
# publishes); the containers override it with sqlserver,1433. DB_PASSWORD is
# also the `sa` password docker-compose sets on first init.
DB_SERVER=localhost,1435
DB_NAME=210050
DB_USER=sa
DB_PASSWORD=

# JWT. JWT_SECRET signs and verifies every token the API issues.
JWT_SECRET=
JwtToken__Issuer=pwm.WebAPI
JwtToken__Audience=pwm.Clients
JwtToken__DurationInMinutes=120
JwtToken__RefreshTokenDurationInDays=7

# RabbitMQ (pwm.WebAPI publishes, pwm.Worker consumes). Host/port are the
# host-side address; the containers override them with rabbitmq:5672.
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__ReportQueueName=report-generation
RabbitMq__NotificationQueueName=notification-push

# pwm.Worker's missed clock-out watchdog: a shift open this many hours is
# reported to admins and project managers, checked every poll interval.
MissedClockOut__ThresholdHours=16
MissedClockOut__PollIntervalMinutes=15

# pwm.Worker's "not at work today" list: on weekdays at this Sarajevo time
# (HH:mm), admins and project managers get the active production workers who
# have not clocked in yet.
AbsenceCheck__TimeOfDay=07:30
