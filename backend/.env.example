# Copy this file to .env (gitignored) and fill in real values. Both
# docker-compose.yml and pwm.WebAPI read the same file - see Program.cs's
# LoadDotEnvFile for how the API picks it up.

# The SQL Server `sa` password: docker-compose sets it on first init, and
# BuildConnectionString in Program.cs appends it to PWMConnection.
DB_PASSWORD=

# Signs and verifies every JWT the API issues. appsettings.json's JwtToken
# section carries the issuer, audience and lifetimes - never this.
JWT_SECRET=
